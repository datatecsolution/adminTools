	<queryString>
		<![CDATA[SELECT
	`detalle_devoluciones_compra`.`fecha` AS `fecha_devolucion`,
	`encabezado_factura_compra`.`numero_compra` AS `numero_compra`,
	`detalle_devoluciones_compra`.`total` AS `total_dev`,
	`detalle_devoluciones_compra`.`cantidad` AS `cantidad`,
	`proveedor`.`codigo_proveedor` AS `codigo_proveedor`,
	`proveedor`.`nombre_proveedor` AS `nombre_proveedor`,
	`proveedor`.`telefono` AS `telefono`,
	`proveedor`.`telefono` AS `direccion`,
	`articulo`.`articulo` AS `articulo` 
FROM
	(((
				$P!{bD_admin}.`encabezado_factura_compra`
				JOIN $P!{bD_admin}.`detalle_devoluciones_compra` ON ((
						`encabezado_factura_compra`.`numero_compra` = `detalle_devoluciones_compra`.`numero_factura` 
					)))
			JOIN $P!{bD_admin}.`proveedor` ON ((
					`encabezado_factura_compra`.`codigo_proveedor` = `proveedor`.`codigo_proveedor` 
				)))
		JOIN $P!{bD_admin}.`articulo` ON ((
			`detalle_devoluciones_compra`.`codigo_articulo` = `articulo`.`codigo_articulo` 
	)))
where 
`encabezado_factura_compra`.numero_compra =  $P{numero_factura}]]>
	</queryString>
